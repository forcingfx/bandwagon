#!/usr/bin/env bash
# GTD app: `gtd` opens the TUI; `gtd <command>` runs the automation CLI (see `gtd --help`).
# Creates its own venv on first run so the vaults' scripts stay stdlib-only.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
venv="$root/.venv"
if [ ! -x "$venv/bin/python" ]; then
  python3 -m venv "$venv"
  "$venv/bin/pip" install -q -r "$root/requirements.txt"
fi
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$venv/bin/python" -m gtd "$@"
